{
  "name": "easy-finance",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "db:init": "node --env-file-if-exists=.env.local scripts/init-db.mjs",
    "test": "node scripts/run-checks.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "cards:import": "node --use-system-ca --env-file-if-exists=.env.local scripts/import-card-invoices.mjs",
    "accounts:create-personal": "node --use-system-ca --env-file-if-exists=.env.local scripts/create-personal-account.mjs",
    "build": "node scripts/build-app.mjs",
    "pretest": "npm run build",
    "bank:import": "node --use-system-ca --env-file-if-exists=.env.local scripts/import-bank-statements.mjs",
    "pretest:browser": "npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
